# ============================================================
#  .NET / ASP.NET Core — backend .gitignore
# ============================================================

# --------------------------
# ⛔ SECRETS — never commit
# --------------------------
secrets.json
**/secrets.json
.env
.env.*
*.pfx
*.p12
*.key
*.pem

# Protect any accidentally-created local appsettings overrides
# (appsettings.Production.json, appsettings.Staging.json, etc.)
# Keep appsettings.json and appsettings.Development.json tracked (no real creds).
appsettings.Production.json
appsettings.Staging.json


[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
out/
build/
dist/

# --------------------------
# .NET project files
# --------------------------
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
.vs/
*.rsuser

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
nuget.config   # keep if you have a custom one; remove this line if so

# Restore / lock files (generated automatically)
project.lock.json
project.fragment.lock.json
artifacts/

# --------------------------
# ASP.NET Core / Runtime
# --------------------------
# User secrets (never commit!)
**/secrets.json
**/appsettings.*.json
# Un-comment the next line if you want to keep appsettings.Development.json tracked:
# !**/appsettings.Development.json

# Published output
**/publish/
**/PublishProfiles/

# --------------------------
# Test results & coverage
# --------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
coverage*/
*.coverage
*.coveragexml
*.trx

# --------------------------
# Logs
# --------------------------
logs/
*.log
*.log.*

# --------------------------
# IDE — Visual Studio
# --------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
*.VC.VC.opendb
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.psess
*.vsp
*.vspx
*.sap

# --------------------------
# IDE — JetBrains Rider
# --------------------------
.idea/
*.sln.iml

# --------------------------
# IDE — VS Code
# --------------------------
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# --------------------------
# Docker
# --------------------------
.dockerignore
# Keep your Dockerfile tracked; only ignore generated compose overrides:
docker-compose.override.yml

# --------------------------
# Environment / secrets
# --------------------------
.env
.env.*
*.pfx
*.p12
*.key
*.pem

# --------------------------
# OS generated files
# --------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
